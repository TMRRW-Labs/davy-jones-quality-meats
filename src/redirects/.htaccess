# Apache fallback for the redirect map in _redirects. Only used if the site
# ever moves off Netlify / Cloudflare Pages onto Apache hosting.
#
# The new site reuses the slugs the live WordPress site already has indexed,
# so /beef/, /chicken/, /pork/, /sausage/, /appetizers/, /gluten-free/,
# /dry-aged-meats/, /freezer-packs/, /contact/ and /products/ need no rule.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Beef sub-pages are now sections of the single beef page.
  RewriteRule ^beef/steak/?$            /beef/#steak [R=301,L,NE]
  RewriteRule ^beef/burgers/?$          /beef/#burgers [R=301,L,NE]
  RewriteRule ^beef/beef-roast/?$       /beef/#roasts [R=301,L,NE]
  RewriteRule ^steaks?/?$               /beef/#steak [R=301,L,NE]
  RewriteRule ^burgers/?$               /beef/#burgers [R=301,L,NE]
  RewriteRule ^roasts/?$                /beef/#roasts [R=301,L,NE]
  RewriteRule ^fresh-beef/?$            /beef/ [R=301,L]

  # Merged pages
  RewriteRule ^meatloaf/?$              /butcher-crafted/#beef [R=301,L,NE]
  RewriteRule ^meat-church-rubs/?$      /pantry-and-rubs/#rubs [R=301,L,NE]
  RewriteRule ^(beef-marrow-)?dog-bones/?$ /pantry-and-rubs/#dog [R=301,L,NE]

  # Discontinued lines (client instruction, Oct 2026)
  RewriteRule ^bbq-pit-boys-rubs/?$     /pantry-and-rubs/#rubs [R=301,L,NE]
  RewriteRule ^fogo(-charcoal)?/?$      /pantry-and-rubs/#rubs [R=301,L,NE]
  RewriteRule ^lumberjack(-pellets)?/?$ /pantry-and-rubs/#rubs [R=301,L,NE]

  # WordPress published Our Story on a duplicate slug.
  RewriteRule ^our-story-2/?$           /our-story/ [R=301,L]

  # Spellings and shortcuts that may exist off-site
  RewriteRule ^(premium-)?dry-aged/?$   /dry-aged-meats/ [R=301,L]
  RewriteRule ^sausages/?$              /sausage/ [R=301,L]
  RewriteRule ^apps/?$                  /appetizers/ [R=301,L]
  RewriteRule ^packs/?$                 /freezer-packs/ [R=301,L]
  RewriteRule ^about(-us)?/?$           /our-story/ [R=301,L]
  RewriteRule ^contact-us/?$            /contact/ [R=301,L]
  RewriteRule ^shop/?$                  /products/ [R=301,L]
  RewriteRule ^privacy-policy/?$        /privacy/ [R=301,L]
  RewriteRule ^terms-of-use/?$          /terms/ [R=301,L]
</IfModule>
